PORT=5000

# Neon — dashboard ke Connect widget se copy karo.
# NOTE: is file me DATABASE_URL sirf ek hi baar likho. dotenv duplicate keys me
# aakhri wali rakhta hai (dotenv/lib/main.js — obj[key] = value), isliye do baar
# define karne se pehli wali chup-chaap overwrite ho jaati hai.
#
# Pooled endpoint (host me "-pooler") — app traffic ke liye.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Direct endpoint (host me "-pooler" NAHI) — sirf `npm run db:migrate` / db:push
# ke liye. Migrations ko session state chahiye jo PgBouncer transaction mode me
# nahi milti.
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Generate with: openssl rand -base64 24
JWT_SECRET=replace_with_a_long_random_string

JWT_EXPIRES_IN=7d

# Browser origins allowed to call the API. Comma-separated for multiple.
# Production me apne Vercel domain daalo, e.g. https://your-app.vercel.app
CORS_ORIGIN=http://localhost:3000

# Razorpay — apne dashboard se (test/live)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cloudinary — apne console se
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Super admin jo `npm run seed` banata hai.
SEED_ADMIN_EMAIL=admin@waterjar.com
# Kam se kam 16 characters. Local me khaali chhodne par default "admin12345"
# lag jaata hai, lekin Vercel pe (VERCEL set hota hai) seed har cold start pe
# chalta hai — isliye wahan short/empty password milne par super admin seed
# SKIP ho jaata hai aur login ka koi raasta nahi bachta. Production me ise
# Vercel env vars me set karna zaroori hai, warna API deploy to ho jaata hai
# par koi admin account create hi nahi hoga.
SEED_ADMIN_PASSWORD=
# Default true — seed karte hi demo vendor/customer/products ban jaate hain.
# Production me hamesha false rakho.
SEED_DEMO_DATA=true

# Email: dev ke liye `npm run smtp:setup` chalao — ye ek throwaway Ethereal
# mailbox banata hai aur upar wali SMTP_* values automatically .env me likh deta
# hai. Real delivery chahiye to apna SMTP provider do (Resend/SES/Postmark).
#
# NOTE: production me Ethereal mat rakho. Wo sirf test mailbox hai, real users
# tak mail nahi pahunchega.
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Water Jar Management <noreply@ethereal.email>
