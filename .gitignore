# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules
.pnp
.pnp.js

# Local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Testing
coverage

# Turbo
.turbo
.turbo-clone-temp

# Vercel
.vercel

# Build Outputs
.next/
out/
build
dist

# apps/api is deployed with a legacy `builds` entry, which disables the Turbo
# build step, so @repo/db and @repo/types must arrive on the build machine
# pre-compiled. `scripts/ensure-workspace-dist.mjs` rebuilds them during
# postinstall and falls back to these files when it cannot run.
# The directory itself has to be un-ignored before its contents.
!packages/db/dist/
!packages/db/dist/**
!packages/types/dist/
!packages/types/dist/**


# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.DS_Store
*.pem
