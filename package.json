{
  "name": "water-jar-management",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "postinstall": "node scripts/ensure-workspace-dist.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "prettier": "3.9.6",
    "turbo": "^2.11.5",
    "typescript": "~5.9.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@10.9.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}